{
  "name": "@ez4/raw-redis",
  "description": "EZ4: External Redis provider (connect to any Redis via TCP or REST API, managed or self-hosted)",
  "version": "0.55.0",
  "author": "Silas B.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "ez4",
    "cache",
    "redis",
    "valkey",
    "rest"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sbalmt/ez4.git",
    "directory": "providers/raw/raw-redis"
  },
  "engines": {
    "node": ">=24.21"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.mjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.mjs"
    }
  },
  "sideEffects": [
    "./dist/main.mjs"
  ],
  "scripts": {
    "lint": "eslint --cache",
    "clean": "rm -rf dist/* *.tsbuildinfo .eslintcache",
    "build": "tsc -p tsconfig.pack.json && node tools/bundler.mjs",
    "test": "npm run build && tsc -p tsconfig.test.json --noEmit && ez4 test",
    "local:publish": "npm run build && npm run clean:registry && npm publish --registry http://localhost:4873",
    "clean:registry": "rm -rf ../../../.registry/@ez4/raw-redis",
    "live:publish": "npm run build && npm publish --access public"
  },
  "dependencies": {
    "@ez4/cache": "^0.55.0",
    "@ez4/common": "^0.55.0",
    "@ez4/logger": "^0.55.0",
    "@ez4/project": "^0.55.0",
    "@ez4/utils": "^0.55.0",
    "iovalkey": "^0.3.3"
  }
}
