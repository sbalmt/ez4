{
  "name": "@ez4/aws-aurora",
  "description": "EZ4: Self-managed AWS Aurora serverless v2 provider",
  "version": "0.55.0",
  "author": "Silas B.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "ez4",
    "aurora",
    "postgres",
    "rds",
    "aws"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sbalmt/ez4.git",
    "directory": "providers/aws/aws-aurora"
  },
  "engines": {
    "node": ">=24.21"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.mjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.mjs"
    },
    "./client/api": {
      "types": "./dist/client-api.d.ts",
      "default": "./dist/client-api.mjs"
    },
    "./client/native": {
      "types": "./dist/client-native.d.ts",
      "default": "./dist/client-native.mjs"
    }
  },
  "sideEffects": [
    "./dist/main.mjs"
  ],
  "workspaces": [
    "foundation/*",
    "contracts/*",
    "providers/aws/*"
  ],
  "scripts": {
    "lint": "eslint --cache",
    "clean": "rm -rf dist/* *.tsbuildinfo .eslintcache",
    "build": "tsc -p tsconfig.pack.json && node tools/bundler.mjs",
    "test": "npm run build && tsc -p tsconfig.test.json --noEmit && ez4 test -e ../../../local.env",
    "local:publish": "npm run build && npm run clean:registry && npm publish --registry http://localhost:4873",
    "clean:registry": "rm -rf ../../../.registry/@ez4/aws-aurora",
    "live:publish": "npm run build && npm publish --access public"
  },
  "dependencies": {
    "@aws-sdk/client-rds": "^3.1127.0",
    "@aws-sdk/client-rds-data": "^3.1127.0",
    "@aws-sdk/client-secrets-manager": "^3.1127.0",
    "@ez4/aws-common": "^0.55.0",
    "@ez4/aws-identity": "^0.55.0",
    "@ez4/common": "^0.55.0",
    "@ez4/database": "^0.55.0",
    "@ez4/pgclient": "^0.55.0",
    "@ez4/pgmigration": "^0.55.0",
    "@ez4/pgsql": "^0.55.0",
    "@ez4/project": "^0.55.0",
    "@ez4/schema": "^0.55.0",
    "@ez4/state": "^0.55.0",
    "@ez4/utils": "^0.55.0"
  }
}
