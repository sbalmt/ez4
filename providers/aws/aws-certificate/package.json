{
  "name": "@ez4/aws-certificate",
  "description": "EZ4: Self-managed AWS certificate provider",
  "version": "0.57.0",
  "author": "Silas B.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "ez4",
    "certificate",
    "acm",
    "aws"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sbalmt/ez4.git",
    "directory": "providers/aws/aws-certificate"
  },
  "engines": {
    "node": ">=24.21"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.mjs"
    }
  },
  "sideEffects": [
    "./dist/main.mjs"
  ],
  "workspaces": [
    "foundation/*",
    "contracts/*",
    "providers/aws/*"
  ],
  "scripts": {
    "lint": "eslint --cache",
    "clean": "rm -rf dist/* *.tsbuildinfo .eslintcache",
    "check": "tsc -p tsconfig.pack.json && tsc -p tsconfig.test.json --noEmit",
    "build": "npm run check && node tools/bundler.mjs",
    "test": "npm run build && ez4 test -e ../../../local.env",
    "local:publish": "npm run build && npm run clean:registry && npm publish --registry http://localhost:4873",
    "clean:registry": "rm -rf ../../../.registry/@ez4/aws-certificate",
    "live:publish": "npm run build && npm publish --access public"
  },
  "dependencies": {
    "@aws-sdk/client-acm": "^3.1127.0",
    "@ez4/aws-common": "^0.57.0",
    "@ez4/state": "^0.57.0",
    "@ez4/utils": "^0.57.0"
  }
}
