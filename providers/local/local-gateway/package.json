{
  "name": "@ez4/local-gateway",
  "description": "EZ4: Local gateway emulator",
  "version": "0.56.0",
  "author": "Silas B.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "ez4",
    "local",
    "emulator",
    "gateway",
    "api"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sbalmt/ez4.git",
    "directory": "providers/local/local-gateway"
  },
  "engines": {
    "node": ">=24.21"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.mjs"
    },
    "./tester": {
      "types": "./dist/tester.d.ts",
      "default": "./dist/tester.mjs"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.mjs"
    }
  },
  "workspaces": [
    "foundation/*",
    "providers/local/*"
  ],
  "scripts": {
    "clean": "rm -rf dist/* *.tsbuildinfo .eslintcache",
    "build": "tsc -p tsconfig.pack.json && node tools/bundler.mjs",
    "test": "npm run build && tsc -p tsconfig.test.json --noEmit && ez4 test",
    "local:publish": "npm run build && npm run clean:registry && npm publish --registry http://localhost:4873",
    "clean:registry": "rm -rf ../../../.registry/@ez4/local-gateway",
    "live:publish": "npm run build && npm publish --access public"
  },
  "dependencies": {
    "@ez4/common": "^0.56.0",
    "@ez4/emulator": "^0.56.0",
    "@ez4/gateway": "^0.56.0",
    "@ez4/http": "^0.56.0",
    "@ez4/local-common": "^0.56.0",
    "@ez4/logger": "^0.56.0",
    "@ez4/project": "^0.56.0",
    "@ez4/runtime": "^0.56.0",
    "@ez4/schema": "^0.56.0",
    "@ez4/server": "^0.56.0",
    "@ez4/utils": "^0.56.0",
    "@ez4/validator": "^0.56.0"
  }
}
