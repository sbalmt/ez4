{
  "name": "@ez4/local-cache",
  "description": "EZ4: Local cache emulator",
  "version": "0.55.0",
  "author": "Silas B.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "ez4",
    "local",
    "emulator",
    "cache"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sbalmt/ez4.git",
    "directory": "providers/local/local-cache"
  },
  "engines": {
    "node": ">=24.21"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.mjs"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "default": "./dist/test.mjs"
    },
    "./run": {
      "types": "./dist/run.d.ts",
      "default": "./dist/run.mjs"
    }
  },
  "workspaces": [
    "foundation/*",
    "providers/local/*"
  ],
  "scripts": {
    "lint": "eslint --cache",
    "clean": "rm -rf dist/* *.tsbuildinfo .eslintcache",
    "build": "tsc -p tsconfig.pack.json && node tools/bundler.mjs",
    "test": "npm run build && tsc -p tsconfig.test.json --noEmit && ez4 test",
    "local:publish": "npm run build && npm run clean:registry && npm publish --registry http://localhost:4873",
    "clean:registry": "rm -rf ../../../.registry/@ez4/local-cache",
    "live:publish": "npm run build && npm publish --access public"
  },
  "dependencies": {
    "@ez4/cache": "^0.55.0",
    "@ez4/logger": "^0.55.0",
    "@ez4/local-common": "^0.55.0",
    "@ez4/project": "^0.55.0",
    "@ez4/utils": "^0.55.0"
  }
}
