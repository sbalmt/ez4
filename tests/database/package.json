{
  "name": "@ez4/tests-database",
  "description": "Database contract test helpers",
  "version": "0.0.0",
  "author": "Silas B.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.7"
  },
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "require": "./dist/main.cjs",
      "import": "./dist/main.mjs"
    }
  },
  "workspaces": [
    "foundation/*",
    "contracts/*",
    "tests/*"
  ],
  "scripts": {
    "lint": "eslint --cache",
    "clean": "rm -rf dist/* *.tsbuildinfo .eslintcache",
    "build": "tsc -p tsconfig.pack.json && node tools/bundler.mjs",
    "test": "npm run build && tsc -p tsconfig.test.json --noEmit && ez4 test -e ../../../local.env",
    "clean:registry": "rm -rf ../../../.registry/@ez4/tests-database"
  },
  "dependencies": {
    "@ez4/database": "^0.51.0",
    "@ez4/schema": "^0.51.0"
  }
}