# AWS credentials used to deploy the API.
AWS_SECRET_ACCESS_KEY=
AWS_ACCESS_KEY_ID=
AWS_REGION=

# Redis connection. Copy this file to `local.env` and fill in your own values. Never commit secrets.
#
# Var name format: EZ4_RAW_REDIS_<SERVICE_NAME>_URL (snake-uppercase).
# Service `CacheService` → `EZ4_RAW_REDIS_CACHE_SERVICE_URL`.
#
# Redis protocol: redis://user:password@host:6379 (or rediss:// for TLS).
# Redis REST API: https://<host>, with the token below.
EZ4_RAW_REDIS_CACHE_SERVICE_URL=redis://127.0.0.1:6379
EZ4_RAW_REDIS_CACHE_SERVICE_TOKEN=
